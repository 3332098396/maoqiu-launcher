{
  "name": "mc-launcher",
  "productName": "毛球",
  "version": "0.4.5",
  "description": "毛球 — Minecraft Java 版启动器（Windows 本地）",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "毛球 (Maoqiu) <https://github.com/3332098396/maoqiu-launcher>",
  "homepage": "https://github.com/3332098396/maoqiu-launcher",
  "scripts": {
    "start": "node scripts/start.js",
    "icons": "node scripts/make-icons.js",
    "skin-agent": "node scripts/build-offline-skin.js",
    "dist": "node scripts/build.js"
  },
  "devDependencies": {
    "archiver": "^5.3.2",
    "archiver-zip-encrypted": "^2.0.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "minizip-asm.js": "^1.0.10",
    "three": "^0.186.1"
  },
  "build": {
    "appId": "com.local.mc-launcher",
    "productName": "毛球",
    "copyright": "Copyright © 2026 毛球 (Maoqiu) — MIT 许可，转载/改编必须保留署名",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "assets/offline-skin/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "shortcutName": "毛球",
      "artifactName": "毛球-安装程序-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
